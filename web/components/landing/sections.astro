---
// The landing page below the hero. Type doing the work, plain label/value
// lists instead of cards and borders, and a tiny uppercase footer.
interface Props { readonly links: readonly { label: string; href: string }[] }

const { links } = Astro.props;

const facts = [
  { key: "Phone number", value: "Not needed. You pick a handle." },
  { key: "Servers", value: "No message servers. Messages go device to device." },
  { key: "Tracking", value: "No analytics, ads or crash reporters." },
  { key: "Keys", value: "Made on your device and never sent to us." },
  { key: "Source", value: "Open, and self-hostable." },
  { key: "Terminal", value: "Link a second device and chat from the CLI." },
];

const platforms = [
  { key: "iOS", value: "App Store", href: "#" },
  { key: "Android", value: "Google Play", href: "#" },
  { key: "Terminal", value: "qop link --account you", href: "/docs", mono: true },
];
---

<section class="profile">
  <p class="small label">About</p>
  <p class="big">
    <strong>qop</strong> is a messaging app where every message goes <span class="mono">straight from your phone to theirs.</span>{" "}
    No servers in the middle, no phone number, and keys that never leave your devices.
  </p>
</section>

<section class="list">
  <p class="small label">What you keep</p>
  <dl>
    {
      facts.map((f) => (
        <div>
          <dt class="small">{f.key}</dt>
          <dd>{f.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<section class="list" id="download">
  <p class="small label">Get qop</p>
  <dl>
    {
      platforms.map((p) => (
        <div>
          <dt class="small">{p.key}</dt>
          <dd>
            <a href={p.href} class:list={{ mono: p.mono }}>
              {p.value} <span aria-hidden="true">↗</span>
            </a>
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<footer class="meta small foot">
  <span>QOP</span>
  <span class="dot" aria-hidden="true"></span>
  <span>{links.map((l) => <a href={l.href}>{l.label}</a>)}</span>
  <span>Built on minip2p</span>
  <span>qop.sh<br />©2026</span>
</footer>

<style>
  .small {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.35;
    margin: 0;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: var(--qp-orange);
  }
  .mono {
    font-family: var(--blume-font-mono);
    letter-spacing: -0.03em;
  }
  .dot {
    width: 7px;
    height: 7px;
    background: var(--qp-ink);
  }

  .meta {
    display: grid;
    grid-template-columns: 1fr 1.6rem 1fr 1fr 1fr;
    align-items: start;
    padding: 2.5rem 0.75rem 3rem;
  }
  .meta .dot {
    margin-top: 0.15rem;
  }

  .profile,
  .list {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 1rem;
    padding: 7rem 0.75rem 0;
  }
  .label {
    padding-top: 0.9rem;
  }
  .big {
    margin: 0;
    color: var(--qp-ink);
    font-size: clamp(2rem, 4.2vw, 3.6rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 400;
  }
  .big strong {
    font-weight: 600;
  }

  dl {
    margin: 0;
  }
  dl div {
    display: grid;
    grid-template-columns: 1fr 2fr;
    align-items: baseline;
    gap: 1rem;
    padding: 0.35rem 0;
  }
  dt {
    color: var(--qp-muted);
  }
  /* Blume's prose indents <dd>; these lists are flush. */
  dd {
    margin: 0;
    padding: 0;
    color: var(--qp-ink);
    font-size: clamp(1.15rem, 1.8vw, 1.5rem);
    letter-spacing: -0.02em;
  }

  .foot {
    margin-top: 9rem;
    padding-bottom: 1.25rem;
  }
  .foot a {
    display: block;
  }

  @media (max-width: 48rem) {
    .meta {
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
    .meta .dot {
      display: none;
    }
    .profile,
    .list,
    dl div {
      grid-template-columns: 1fr;
    }
    /* Line up with the hero copy and tighten the desktop spacing. */
    .profile,
    .list {
      gap: 0.5rem;
      padding: 4rem 1.75rem 0;
    }
    .meta {
      padding-inline: 1.75rem;
    }
    .big {
      font-size: 1.65rem;
    }
    dl div {
      gap: 0.15rem;
      padding: 0.6rem 0;
    }
    .foot {
      margin-top: 5rem;
    }
  }
</style>
