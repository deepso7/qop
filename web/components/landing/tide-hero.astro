---
// "Tide" hero for the landing page: a full-bleed multi-shade dither (see
// tide.ts) under the floating site header, with the copy on the bare paper
// below the shore. The tide follows the site theme and redraws when it changes.
---

<section class="not-prose relative h-svh max-h-200 min-h-152 overflow-hidden">
  <canvas class="absolute inset-0 size-full" data-tide></canvas>
  <div class="absolute inset-x-0 bottom-16">
    <div class="mx-auto max-w-6xl px-6">
      <div class="max-w-lg">
        <p class="mb-4 font-mono text-xs text-brand">peer → peer</p>
        <h1 class="mb-4 font-mono text-5xl leading-none font-normal tracking-tighter text-ink md:text-6xl">
          Nothing in<br />the middle.
        </h1>
        <p class="mb-8 text-lg leading-relaxed text-subtle">
          qop sends each message straight from your phone to theirs. No server holds it, reads it, or keeps it.
        </p>
        <div class="flex items-center gap-6">
          <a class="bg-ink px-4 py-2 text-paper notch hover:bg-brand hover:text-on-foam" href="#download">Download</a>
          <a class="font-mono text-sm text-ink hover:text-brand" href="/docs">$ qop --help</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { tide } from "./tide";

  // Blume's client router swaps pages without a reload and runs this module
  // once, so (re)mount on every page load and stop before each swap.
  let stop: (() => void) | undefined;

  const mount = () => {
    const canvas = document.querySelector<HTMLCanvasElement>("[data-tide]");

    if (!canvas) {
      return;
    }

    // Draw in the current theme, and redraw when the reader toggles it.
    const root = document.documentElement;
    const draw = () => tide(canvas, root.dataset.theme === "dark" ? "dark" : "light");
    let stopTide = draw();
    const observer = new MutationObserver(() => {
      stopTide();
      stopTide = draw();
    });

    observer.observe(root, { attributes: true, attributeFilter: ["data-theme"] });
    stop = () => {
      stopTide();
      observer.disconnect();
    };
  };

  document.addEventListener("astro:page-load", mount);
  document.addEventListener("astro:before-swap", () => {
    stop?.();
    stop = undefined;
  });
</script>

