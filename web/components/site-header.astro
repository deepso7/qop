---
// qop's site header, used on every page through the `Header` layout slot
// (components.ts): the app-icon mark, a nav chip, search, a pixel theme toggle
// and Download. On the landing page (`/`) it floats over the tide with pale
// chips; elsewhere it is a sticky bar on the page background.
import Icon from "blume/components/Icon.astro";
import Search from "blume/components/layout/Search.astro";
import data from "blume:data";

// The props Blume's built-in header receives that this one uses.
interface Props {
  readonly route: string;
  readonly navigation: Parameters<typeof Search>[0]["navigation"];
  readonly searchEnabled: boolean;
  readonly searchStrings?: Parameters<typeof Search>[0]["strings"];
  readonly searchLocale?: string;
  readonly searchVersion?: string | null;
  readonly assistantEnabled?: boolean;
}

const { route, navigation, searchEnabled, searchStrings, searchLocale, searchVersion = null, assistantEnabled = false } = Astro.props;

const overTide = route === "/";

// Chips are pale on the tide and a quiet surface on the page. h-8 chips with
// py-4 make the header h-16, like Blume's own.
const chip = ["flex h-8 items-center notch-sm text-sm", overTide ? "bg-foam text-on-foam" : "bg-surface text-ink"];

// Orange hover text at AA contrast for the chip it sits on.
const accent = overTide ? "hover:text-link-on-foam" : "hover:text-link";

const searchAccent = overTide
  ? "[&_[data-blume-search-open]:hover]:text-link-on-foam"
  : "[&_[data-blume-search-open]:hover]:text-link";

const iconChip = [...chip, "w-8 cursor-pointer justify-center border-0 p-0", accent];

const links = [
  { label: "docs", href: "/docs" },
  { label: "github", href: "https://github.com/deepso7/qop" },
];

// The 9x9 pixel menu icon, drawn one unit square per "#". It renders in a
// size-6 box at 2px per pixel (viewBox padded to 12 units).
const MENU = [".........", "#########", "#########", ".........", "#########", "#########", ".........", "#########", "#########"];

const menuPath = MENU.flatMap((row, y) => [...row].map((c, x) => (c === "#" ? `M${x} ${y}h1v1h-1z` : ""))).join("");
---

<header
  class:list={[
    "z-40 flex items-center gap-2 px-6 py-4",
    overTide ? "absolute inset-x-0 top-0" : "sticky top-0 bg-paper",
  ]}
  data-blume-header
>
  <!-- On every page (Blume renders the drawer everywhere), so the logo never shifts. -->
  <button
    type="button"
    class:list={[iconChip, "lg:hidden"]}
    aria-controls="blume-nav-drawer"
    aria-expanded="false"
    aria-label="Toggle navigation"
    data-blume-nav-toggle
  >
    <svg class="size-6" viewBox="-1.5 -1.5 12 12" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true">
      <path d={menuPath} />
    </svg>
  </button>
  <!-- The app-icon mark on a tile that inverts per theme (see theme.css). -->
  <a href="/" class="grid size-8 place-items-center bg-mark-tile text-mark notch-sm" aria-label="qop home">
    <svg class="size-6" viewBox="0 0 128 128" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true">
      <path d="M32 16h64v32H32zM16 32h32v64H16zM80 32h32v64H80zM32 80h64v32H32z" />
    </svg>
  </a>
  <nav class:list={[chip, "hidden gap-6 px-4 sm:flex"]} aria-label="Site">
    {
      links.map((l) => (
        <a
          href={l.href}
          class:list={[accent, "aria-[current=page]:text-link"]}
          aria-current={route.startsWith(l.href) ? "page" : undefined}
        >
          {l.label}
        </a>
      ))
    }
  </nav>
  <div class="ml-auto flex gap-2">
    {
      searchEnabled && (
        <span
          class:list={[
            chip,
            // Blume's search trigger, restyled to fill the chip.
            "[&_[data-blume-search-open]]:size-8 [&_[data-blume-search-open]]:rounded-none [&_[data-blume-search-open]]:text-inherit [&_[data-blume-search-open]:hover]:bg-transparent",
            searchAccent,
          ]}
        >
          <Search
            assistantEnabled={assistantEnabled}
            locale={searchLocale}
            navigation={navigation}
            popularPages={data.config.search.popular}
            strings={searchStrings}
            version={searchVersion}
          />
        </span>
      )
    }
    <button type="button" class:list={iconChip} data-blume-theme-toggle aria-label="Toggle dark mode">
      <!-- Blume's own toggle icons: the sun in light mode, the moon in dark. -->
      <Icon name="sun" size={18} class="dark:hidden" />
      <Icon name="moon" size={18} class="hidden dark:block" />
    </button>
    <a href="/#download" class:list={[chip, "px-4", accent]}>Download</a>
  </div>
</header>

<script>
  // Replacing Blume's header drops its click handlers, so this mirrors them:
  // the theme toggle (remembered under Blume's "blume-theme" key, which its
  // head script reads on load) and the docs sidebar drawer on small screens.
  const root = document.documentElement;

  const save = (key: string, value: string) => {
    try {
      localStorage.setItem(key, value);
    } catch {
      // Storage blocked: the choice applies but isn't remembered.
    }
  };

  // The drawer sits under the header; Blume's drawer styles read this offset.
  const placeDrawer = () => {
    const header = document.querySelector("[data-blume-header]");

    if (header) {
      root.style.setProperty("--blume-drawer-top", `${header.getBoundingClientRect().bottom}px`);
    }
  };

  document.addEventListener("click", (event) => {
    const target = event.target instanceof Element ? event.target : null;

    if (target?.closest("[data-blume-theme-toggle]")) {
      const next = root.dataset.theme === "dark" ? "light" : "dark";

      root.dataset.theme = next;
      save("blume-theme", next);
    }

    if (target?.closest("[data-blume-nav-toggle]")) {
      if (Object.hasOwn(root.dataset, "blumeNavOpen")) {
        delete root.dataset.blumeNavOpen;
      } else {
        root.dataset.blumeNavOpen = "";
        placeDrawer();
      }
    }
  });

  // Crossing into the desktop layout closes the drawer so its scroll lock can't outlive it.
  addEventListener("resize", () => {
    if (!Object.hasOwn(root.dataset, "blumeNavOpen")) {
      return;
    }

    if (matchMedia("(min-width: 64rem)").matches) {
      delete root.dataset.blumeNavOpen;
    } else {
      placeDrawer();
    }
  });
</script>

