---
// qop's site footer: the mark, a one-line blurb and the link columns on bare
// paper, a hairline and the copyright row, then the stipple bay art
// (footer-art.ts) full width, bleeding off the bottom. The landing page renders
// it after its sections; every docs page gets it through the `Footer` layout
// slot (components.ts), so both ends of the site share it.
const columns = [
  {
    title: "Product",
    links: [
      { label: "Download", href: "/#download" },
      { label: "Docs", href: "/docs" },
      { label: "CLI", href: "/docs/cli" },
    ],
  },
  {
    title: "Project",
    links: [
      { label: "GitHub", href: "https://github.com/deepso7/qop" },
      { label: "minip2p", href: "https://minip2p.com" },
      { label: "Privacy", href: "/privacy" },
    ],
  },
];
---

<footer class="not-prose mt-16 overflow-hidden bg-paper text-ink md:mt-24" data-blume-footer>
  <div class="mx-auto max-w-6xl px-4 pt-12 md:px-6 md:pt-16">
    <div class="grid grid-cols-2 gap-10 sm:grid-cols-[1fr_auto_auto] sm:gap-16">
      <div class="col-span-2 sm:col-span-1">
        <a href="/" class="inline-flex items-center gap-2.5 text-xl tracking-[-0.03em]" aria-label="qop home">
          <svg class="size-6 text-brand" viewBox="0 0 128 128" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true">
            <path d="M32 16h64v32H32zM16 32h32v64H16zM80 32h32v64H80zM32 80h64v32H32z"></path>
          </svg>
          qop
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-subtle">
          Your messages. Nobody else's. Sent straight from one phone to another.
        </p>
      </div>
      {
        columns.map((c) => (
          <div class="text-sm">
            <p class="mb-4 text-link">{c.title}</p>
            <ul class="grid gap-2.5">
              {c.links.map((l) => (
                <li>
                  <a href={l.href} class="text-subtle transition-colors hover:text-ink">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="mt-12 flex justify-between gap-4 border-t border-line pt-5 text-xs text-subtle">
      <span>©2026 qop.sh</span>
      <span>Built on minip2p</span>
    </div>
  </div>
  <!-- Drawn in the canvas's CSS colour: terracotta ink, a little dimmed on dark paper. -->
  <canvas class="mt-6 block h-[clamp(19rem,30vw,27rem)] w-full text-brand md:mt-2 dark:text-brand/80" data-footer-art aria-hidden="true"
  ></canvas>
</footer>

<script>
  import { footerArt } from "./footer-art";

  // Blume's client router swaps pages without a reload and runs this module
  // once, so (re)mount on every page load and stop before each swap.
  let stop: (() => void) | undefined;

  const mount = () => {
    const canvas = document.querySelector<HTMLCanvasElement>("[data-footer-art]");

    if (!canvas) {
      return;
    }

    // Draw in the current theme, and redraw when the reader toggles it.
    const root = document.documentElement;
    const draw = () => footerArt(canvas, { dark: root.dataset.theme === "dark" });
    let stopArt = draw();

    const observer = new MutationObserver(() => {
      stopArt();
      stopArt = draw();
    });

    observer.observe(root, { attributes: true, attributeFilter: ["data-theme"] });
    stop = () => {
      stopArt();
      observer.disconnect();
    };
  };

  document.addEventListener("astro:page-load", mount);

  document.addEventListener("astro:before-swap", () => {
    stop?.();
    stop = undefined;
  });
</script>
