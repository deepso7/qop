---
// PROTOTYPE: draws a bitmap (rows of "#" and ".") as crisp SVG pixels.
type Props = { readonly rows: readonly string[]; readonly size?: number };

const { rows, size = 28 } = Astro.props;
const width = rows[0]?.length ?? 0;
---

<svg
  width={size}
  height={(size / width) * rows.length}
  viewBox={`0 0 ${width} ${rows.length}`}
  shape-rendering="crispEdges"
  fill="currentColor"
  aria-hidden="true"
>
  {rows.flatMap((row, y) => [...row].map((c, x) => (c === "#" ? <rect x={x} y={y} width="1" height="1" /> : null)))}
</svg>
