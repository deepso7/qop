---
// PROTOTYPE: the two sections already picked (Teak-style feature grid,
// Linear-style download rows), shared by every hero variant.
import PixelIcon from "./PixelIcon.astro";

const features = [
  { label: "No phone number", icon: ["#####", "#...#", "#####", "#...#", "#####", "#.#.#", "#####"] },
  { label: "No message servers", icon: ["#####", "#.#.#", "#####", ".....", "#####", "#.#.#", "#####"] },
  { label: "No tracking", icon: [".###.", "#...#", "#.#.#", "#...#", ".###.", ".....", "#####"] },
  { label: "Keys stay on device", icon: [".##..", "#..#.", "#..#.", ".####", "...#.", "...##", "...#."] },
  { label: "Open source", icon: ["#...#", ".#.#.", "..#..", ".#.#.", "#...#", ".....", "#####"] },
  { label: "Self-hostable", icon: ["..#..", ".###.", "#####", "#.#.#", "#.#.#", "#.###", "#####"] },
  { label: "Works in the terminal", icon: ["#####", "#...#", "##..#", "#.#.#", "##..#", "#...#", "#####"] },
];

const qr = ["#######.#.#", "#.....#..##", "#.###.#.#..", "#.###.#..#.", "#.....#.##.", "#######.#.#", "...#..#..##", "#.##.#.##.#", "##..#..#.#.", ".#.##.###..", "#.#..#.#.##"];
---

<section class="qp-features">
  <h2>No catch.</h2>
  <div class="qp-grid">
    {
      features.map((f) => (
        <div class="qp-cell">
          <PixelIcon rows={f.icon} />
          <span>{f.label}</span>
        </div>
      ))
    }
  </div>
</section>

<section class="qp-download" id="download">
  <div class="qp-download-head">
    <PixelIcon rows={["........", "..####..", ".######.", ".##..##.", ".##..##.", ".######.", "..####..", "........"]} size={56} />
    <h2>Get qop</h2>
    <p>On your phone, and in your terminal.</p>
  </div>

  <div class="qp-group">
    <p class="qp-group-title"><strong>Phone.</strong> Your account and keys are created here.</p>
    <ul>
      <li>
        <span>iOS</span>
        <span class="qp-actions">
          <button class="qp-chip" popovertarget="qp-qr">Scan QR</button>
          <a class="qp-chip qp-chip-solid" href="#">App Store</a>
        </span>
      </li>
      <li>
        <span>Android</span>
        <span class="qp-actions">
          <button class="qp-chip" popovertarget="qp-qr">Scan QR</button>
          <a class="qp-chip qp-chip-solid" href="#">Google Play</a>
        </span>
      </li>
    </ul>
  </div>

  <div class="qp-group">
    <p class="qp-group-title"><strong>Terminal.</strong> Link a second device, approved from your phone.</p>
    <ul>
      <li>
        <span>CLI <small>macOS · Linux</small></span>
        <span class="qp-actions">
          <code>qop link --account you</code>
          <a class="qp-chip" href="/docs">Docs</a>
        </span>
      </li>
    </ul>
  </div>

  <div id="qp-qr" popover class="qp-qr">
    <PixelIcon rows={qr} size={176} />
    <p>Placeholder QR</p>
  </div>
</section>

<style>
  .qp-features,
  .qp-download {
    max-width: 60rem;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }
  h2 {
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-align: center;
    margin: 0 0 2.5rem;
  }
  .qp-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }
  .qp-cell {
    width: 25%;
    min-width: 10rem;
    aspect-ratio: 1.15;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    border: 1px solid var(--qp-border);
    margin: 0 -1px -1px 0;
    font-family: var(--blume-font-mono);
    font-size: 0.75rem;
    color: var(--qp-muted);
    text-align: center;
    padding: 1rem;
  }
  .qp-cell :global(svg) {
    color: var(--qp-black);
  }
  .qp-cell:hover :global(svg) {
    color: var(--qp-orange);
  }

  .qp-download-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--qp-orange);
    margin-bottom: 3rem;
  }
  .qp-download-head h2 {
    color: var(--qp-black);
    margin: 1.25rem 0 0.5rem;
  }
  .qp-download-head p {
    color: var(--qp-muted);
    margin: 0;
  }
  /* One paper panel; the only separator is the full-width line between groups. */
  .qp-group {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 2rem;
    padding: 1.5rem;
    background: var(--qp-white);
    border: 1px solid var(--qp-border);
  }
  .qp-group + .qp-group {
    border-top: 0;
  }
  .qp-group-title {
    margin: 0;
    padding-top: 0.6rem;
    color: var(--qp-muted);
    font-size: 0.875rem;
  }
  .qp-group-title strong {
    color: var(--qp-black);
    font-weight: 500;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Fixed action columns so buttons line up across rows. */
  li {
    display: grid;
    grid-template-columns: 1fr 5.5rem 7.5rem;
    gap: 0.4rem;
    align-items: center;
    padding: 0.6rem 0;
    font-size: 0.875rem;
  }
  .qp-actions {
    display: contents;
  }
  li:has(code) {
    grid-template-columns: 1fr auto 7.5rem;
  }
  small {
    color: var(--qp-muted);
    margin-left: 0.5rem;
  }
  code {
    font-family: var(--blume-font-mono);
    font-size: 0.75rem;
    background: var(--qp-element);
    padding: 0.3rem 0.5rem;
  }
  .qp-chip {
    font: inherit;
    text-align: center;
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    background: var(--qp-element);
    color: var(--qp-black);
    border: 0;
    cursor: pointer;
    text-decoration: none;
    clip-path: var(--qp-notch-sm);
  }
  .qp-chip-solid {
    background: var(--qp-black);
    color: var(--qp-white);
  }
  .qp-qr {
    border: 1px solid var(--qp-border);
    background: var(--qp-white);
    padding: 1.5rem;
    text-align: center;
    font-size: 0.75rem;
    color: var(--qp-muted);
  }
  .qp-qr::backdrop {
    background: oklch(0.17 0.008 250 / 0.2);
  }
  @media (max-width: 40rem) {
    .qp-cell {
      width: 50%;
    }
    .qp-group {
      grid-template-columns: 1fr;
    }
  }
</style>
