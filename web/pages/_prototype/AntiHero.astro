---
// PROTOTYPE: antimattr.one-style header and hero. Flat page, bracketed mono nav,
// and a line drawing of two phones annotated with pixel-square callouts.
type Props = { readonly links: readonly { label: string; href: string }[] };

const { links } = Astro.props;

// Callouts in diagram units (viewBox 1000 x 470): marker, leader target, label box.
const notes = [
  { text: "[keys are made on this phone and never leave it]", marker: [236, 52], to: [318, 150], label: { left: 3, top: 4, width: 18.5, align: "right" } },
  { text: "[their phone, checked against the public registry]", marker: [764, 82], to: [682, 150], label: { left: 77.5, top: 10.5, width: 19, align: "left" } },
  { text: "[a direct connection. no message server in between]", marker: [500, 420], to: [500, 236], label: { left: 38, top: 92, width: 24, align: "center" } },
] as const;
---

<header class="head">
  <a href="/" class="brand">
    <svg viewBox="0 16 352 128" shape-rendering="crispEdges" fill="currentColor" aria-label="qop">
      <path d="M32 16h64v32H32zM16 32h32v64H16zM80 32h32v112H80zM32 80h64v32H32zM144 16h64v32h-64zM128 32h32v64h-32zM192 32h32v64h-32zM144 80h64v32h-64zM240 16h80v32h-80zM240 16h32v128h-32zM304 32h32v64h-32zM272 80h48v32h-48z" />
    </svg>
    <span>built on minip2p</span>
  </a>
  <nav class="nav">
    <a href="/" aria-current="page">[home]</a>
    {links.map((l) => <a href={l.href}>[{l.label.toLowerCase()}]</a>)}
  </nav>
</header>

<section class="hero">
  <h1>messages that go <em>straight to them</em></h1>

  <div class="diagram">
    <svg viewBox="0 0 1000 470" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
      <!-- Your phone: outgoing bubbles on the right. -->
      <g>
        <rect x="250" y="40" width="150" height="300" rx="26" />
        <rect x="258" y="48" width="134" height="284" rx="19" />
        <rect x="303" y="58" width="44" height="12" rx="6" />
        <rect x="318" y="100" width="62" height="22" rx="8" />
        <rect x="290" y="132" width="90" height="34" rx="8" class="fill" />
        <rect x="272" y="176" width="70" height="22" rx="8" />
        <rect x="270" y="300" width="110" height="18" rx="9" />
      </g>
      <!-- Their phone: the same messages, arriving on the left. -->
      <g>
        <rect x="600" y="40" width="150" height="300" rx="26" />
        <rect x="608" y="48" width="134" height="284" rx="19" />
        <rect x="653" y="58" width="44" height="12" rx="6" />
        <rect x="620" y="100" width="62" height="22" rx="8" />
        <rect x="620" y="132" width="90" height="34" rx="8" />
        <rect x="658" y="176" width="70" height="22" rx="8" />
        <rect x="620" y="300" width="110" height="18" rx="9" />
      </g>
      <!-- The connection, with packets riding it. -->
      <path id="qp-link" d="M400 236 H600" stroke-dasharray="4 5" />
      {
        [0, 1, 2].map((i) => (
          <rect x="-4" y="-4" width="8" height="8" class="packet">
            <animateMotion dur="2.4s" begin={`${i * 0.8}s`} repeatCount="indefinite" keyPoints={i === 1 ? "1;0" : "0;1"} keyTimes="0;1" calcMode="linear">
              <mpath href="#qp-link" />
            </animateMotion>
          </rect>
        ))
      }
      <!-- Leader lines and markers. -->
      {
        notes.map((n) => (
          <>
            <line x1={n.marker[0]} y1={n.marker[1]} x2={n.to[0]} y2={n.to[1]} stroke-dasharray="3 4" class="leader" />
            <rect x={n.marker[0] - 5} y={n.marker[1] - 5} width="10" height="10" class="marker" />
            <rect x={n.to[0] - 4} y={n.to[1] - 4} width="8" height="8" class="marker" />
          </>
        ))
      }
    </svg>
    {
      notes.map((n) => (
        <p class="note" style={`left:${n.label.left}%;top:${n.label.top}%;width:${n.label.width}%;text-align:${n.label.align}`}>
          {n.text}
        </p>
      ))
    }
  </div>

  <p class="name"><span class="sq" aria-hidden="true"></span>qop</p>
  <p class="sub">peer-to-peer messaging. no phone number, no servers in the middle.</p>
  <p class="status">[ios · android · terminal]</p>
  <div class="ctas">
    <a href="/docs" class="btn">read the docs</a>
    <a href="#download" class="btn btn-dark">download</a>
  </div>
</section>

<style>
  a {
    color: inherit;
    text-decoration: none;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.4rem 1.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: var(--qp-muted);
  }
  .brand svg {
    height: 16px;
    color: var(--qp-black);
  }
  .nav {
    display: flex;
    gap: 2rem;
    padding: 0.7rem 2rem;
    background: var(--qp-element);
    border-radius: 6px;
    font-family: var(--blume-font-mono);
    font-size: 0.95rem;
  }
  .nav a:hover,
  .nav [aria-current] {
    color: var(--qp-orange);
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.5rem 1.5rem 4rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.9rem, 3.4vw, 2.8rem);
    font-weight: 400;
    letter-spacing: -0.03em;
  }
  h1 em {
    font-style: normal;
    font-family: var(--blume-font-mono);
    letter-spacing: -0.05em;
  }

  .diagram {
    position: relative;
    width: min(100%, 62rem);
    aspect-ratio: 1000 / 470;
    margin: 2.5rem 0 1.5rem;
    color: oklch(0.42 0.006 250);
  }
  .diagram svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .fill {
    fill: oklch(0.88 0.05 52);
  }
  .leader {
    stroke: oklch(0.55 0.006 250);
  }
  .marker,
  .packet {
    fill: var(--qp-orange);
    stroke: none;
  }
  .note {
    position: absolute;
    margin: 0;
    font-family: var(--blume-font-mono);
    font-size: clamp(0.7rem, 1.1vw, 0.9rem);
    line-height: 1.5;
    color: oklch(0.32 0.006 250);
  }

  .name {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0;
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .sq {
    width: 0.4em;
    height: 0.4em;
    background: var(--qp-orange);
  }
  .sub {
    margin: 0.4rem 0 1.4rem;
    color: var(--qp-muted);
  }
  .status {
    margin: 0 0 1.2rem;
    padding: 0.6rem 1.4rem;
    border: 1px solid var(--qp-orange);
    border-radius: 999px;
    font-family: var(--blume-font-mono);
    font-size: 0.85rem;
    color: var(--qp-orange);
  }
  .ctas {
    display: flex;
    gap: 0.5rem;
  }
  .btn {
    padding: 0.7rem 1rem;
    border-radius: 4px;
    background: var(--qp-element);
    font-family: var(--blume-font-mono);
    font-size: 0.95rem;
  }
  .btn-dark {
    background: var(--qp-black);
    color: var(--qp-white);
  }
  .btn:hover {
    background: var(--qp-orange);
    color: var(--qp-black);
  }

  @media (prefers-reduced-motion: reduce) {
    .packet {
      display: none;
    }
  }
</style>
