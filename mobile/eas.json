{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      },
      "node": "24.20.0",
      "pnpm": "12.3.4"
    },
    "preview": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "distribution": "internal"
      },
      "ios": {
        "distribution": "store"
      },
      "env": {
        "APP_VARIANT": "preview"
      },
      "node": "24.20.0",
      "pnpm": "12.3.4"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production"
      },
      "node": "24.20.0",
      "pnpm": "12.3.4"
    }
  },
  "submit": {
    "preview": {},
    "production": {}
  }
}
