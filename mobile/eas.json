{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      },
      "node": "24.21.0",
      "pnpm": "12.5.1"
    },
    "preview": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "distribution": "internal"
      },
      "ios": {
        "distribution": "store"
      },
      "env": {
        "APP_VARIANT": "preview"
      },
      "node": "24.21.0",
      "pnpm": "12.5.1"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production"
      },
      "node": "24.21.0",
      "pnpm": "12.5.1"
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "ascAppId": "6816326154"
      }
    },
    "production": {}
  }
}
