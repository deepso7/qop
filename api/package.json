{
  "name": "@qop/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.ts",
    "admission:create": "node --env-file=.env src/create-admission-code.ts",
    "db:push": "drizzle-kit push",
    "dev": "node --watch --env-file=.env src/main.ts",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/main.mjs",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.2",
    "@effect/sql-pg": "4.0.2",
    "@qop/identity": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "effect": "catalog:",
    "pg": "8.23.1",
    "viem": "2.57.3"
  },
  "devDependencies": {
    "@effect/sql-pglite": "4.0.2",
    "@effect/vitest": "4.0.2",
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "esbuild": "0.28.2",
    "typescript": "catalog:",
    "vitest": "5.0.3"
  }
}
