{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "lib": ["es2022"],
    "module": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "build.ts",
    "drizzle.config.ts",
    "src/**/*",
    "test/**/*",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
